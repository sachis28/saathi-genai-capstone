@page "/"
@rendermode InteractiveServer
@using System.Text.Json
@using Saathi.Client
@inject ICopilotClient Client
@inject ChatSession Session

@* Agent Workspace: the main demo page (route "/"). Load a customer, ask questions in RAG or *@
@* Agent mode, watch the step-by-step answer trace, create/approve/send a renewal draft, verify the audit log. *@
@* InteractiveServer (above) means buttons and inputs run C# on the server over a live SignalR connection. *@
@* @inject gives the page the Saathi API client and this user's chat session (see Saathi.Client). *@
<PageTitle>Saathi - Agent Workspace</PageTitle>

@* Page header: customer name and a green/red dot showing whether the API is reachable. *@
<div class="ph">
    <div>
        <div class="crumb">Workspace@(customer is null ? "" : $" / Customer {customer.CustomerId}")</div>
        <h1>@(customer?.Name ?? "Agent workspace")</h1>
    </div>
    <span class="status-dot @(apiOk == true ? "ok" : apiOk == false ? "bad" : "")">
        API @(apiOk == true ? "connected" : apiOk == false ? "unreachable" : "checking...")
    </span>
</div>

@* Error and success banners. *@
@if (error is not null)
{
    <div class="banner err" role="alert">@error</div>
}
@if (info is not null)
{
    <div class="banner okmsg">@info</div>
}

@* Customer summary card: the CRM fields returned by GET /customers/{id}. *@
<section class="card cust" aria-label="Customer summary">
    <div class="kv"><div class="k">Customer ID</div><div class="v">@(customer?.CustomerId ?? "-")</div></div>
    <div class="kv"><div class="k">Plan</div><div class="v">@(customer is null ? "-" : $"{customer.Product} · {customer.Tier}")</div></div>
    <div class="kv"><div class="k">Renewal date</div><div class="v">@(customer?.RenewalDate ?? "-")</div></div>
    <div class="kv"><div class="k">Policy status</div><div class="v">
        @if (customer?.PolicyStatus is { } ps) { <span class="badge @(ps is "ACTIVE" ? "g" : ps is "IN_GRACE" ? "a" : "r")">@ps</span> } else { <text>-</text> }
    </div></div>
    <div class="kv"><div class="k">Consent</div><div class="v">
        @if (customer?.Consent is { } consent) { <span class="badge @(consent ? "g" : "r")">@(consent ? "Given" : "Declined")</span> } else { <text>-</text> }
    </div></div>
    <div class="kv"><div class="k">Sentiment (90 days)</div><div class="v">
        @if (sentimentReport?.Score90d is { } ss) { <span class="badge @(ss > 0.2 ? "g" : ss < -0.2 ? "r" : "")">@(ss > 0.2 ? "Positive" : ss < -0.2 ? "Negative" : "Neutral") @((ss >= 0 ? "+" : "") + ss.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))</span> } else { <text>-</text> }
    </div></div>
    <div class="load-row">
        @* @bind keeps the input box and the customerId field in sync. *@
        <input type="text" id="customer-id" @bind="customerId" placeholder="e.g. C-204" aria-label="Customer ID" />
        <button type="button" class="sec" @onclick="LoadCustomerAsync" disabled="@busy">Load</button>
    </div>
    @* Sentiment details: each past interaction with its Azure AI Language label (GET /customers/{id}/sentiment). *@
    @if (sentimentReport is { Interactions.Count: > 0 } rep)
    {
        <details class="more custmore">
            <summary>Show sentiment details (@rep.Interactions.Count interactions)</summary>
            <SentimentList Report="rep" />
        </details>
    }
</section>

@* Two columns: the chat on the left, the answer trace on the right. *@
<div class="cols">
    <section class="card" aria-label="Chat">
        <div class="card-h">
            <h2>Ask Saathi</h2>
            @* Toggle between plain RAG (/chat) and the Semantic Kernel agent (/agent/chat). *@
            <div class="seg" role="group" aria-label="Answer mode">
                <button type="button" class="@(agentMode ? "" : "on")" @onclick="() => agentMode = false">Ask (RAG)</button>
                <button type="button" class="@(agentMode ? "on" : "")" @onclick="() => agentMode = true">Agent (Semantic Kernel)</button>
            </div>
        </div>
        <div class="chat">
            @if (turns.Count == 0)
            {
                <p class="muted">Load a customer, then ask a policy question. Follow-ups like "and what about Gold?" work too. The trace on the right shows each step Saathi took.</p>
            }
            @* One question + one answer bubble per turn. *@
            @for (var i = 0; i < turns.Count; i++)
            {
                var t = turns[i];
                var idx = i;
                <div class="msg agent"><div class="who">You@(t.Agent ? " · agent mode" : "")</div>@t.Question</div>
                @* While waiting for the API, show a "typing" animation. *@
                @if (t.Pending)
                {
                    <div class="msg saathi"><div class="who">Saathi</div><span class="typing"><i></i><i></i><i></i></span></div>
                }
                else
                {
                    <div class="msg saathi @(t.Blocked ? "blocked" : "") @(idx == selected ? "selected" : "")">
                        <div class="who">Saathi</div>
                        @* Comparison answers are drawn as a table: one row per aspect, one column per tier, each cell cited. *@
                        @if (t.Comparison is { } cmp)
                        {
                            <div>@($"{cmp.Product} {string.Join(" vs ", cmp.Tiers)}, from the policy clauses")</div>
                            <table class="compare">
                                <thead><tr><th></th>@foreach (var tier in cmp.Tiers) { <th>@tier</th> }</tr></thead>
                                <tbody>
                                    @foreach (var row in cmp.Rows)
                                    {
                                        <tr>
                                            <th>@row.Aspect</th>
                                            @foreach (var tier in cmp.Tiers)
                                            {
                                                var cell = row.Cells.GetValueOrDefault(tier);
                                                <td>
                                                    @if (cell is null) { <span class="muted">Not stated</span> }
                                                    else { <div>@cell.Text</div><span class="cite" title="Version @cell.Version">@($"{cell.SourceId}#{cell.ClauseId}")</span> }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            @* Normal answers: the text, then one chip per citation (SCAN- chips are clauses read by OCR). *@
                            <div style="white-space: pre-line">@t.Answer</div>
                        }
                        <div class="meta">
                            @if (t.Comparison is null)
                            {
                                @foreach (var c in t.Citations)
                                {
                                    <span class="cite @(IsScan(c) ? "scan" : "")" title="@CiteTitle(c)">@($"{c.SourceId}#{c.ClauseId}")</span>
                                }
                            }
                            <button type="button" class="link-btn" @onclick="() => ShowTraceAsync(idx)">View trace</button>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="ask">
            <div class="chips">
                @* Suggested questions, to make the live demo quick. *@
                @foreach (var s in Suggestions)
                {
                    <button type="button" disabled="@(busy || customer is null)" @onclick="() => AskAsync(s)">@s</button>
                }
            </div>
            <div class="ask-row">
                @* @bind:event="oninput" updates the field on every key press; Enter sends (OnKeyAsync). *@
                <input type="text" id="question" @bind="question" @bind:event="oninput" @onkeydown="OnKeyAsync"
                       placeholder="@(agentMode ? "Ask the agent, e.g. Is air ambulance covered?" : "Ask about this customer's policy")" aria-label="Question"
                       disabled="@(customer is null)" />
                <button type="button" @onclick="() => AskAsync(question)" disabled="@(busy || customer is null)">Send</button>
            </div>
        </div>
    </section>

    @* The answer trace: replays what happened inside the API for the selected answer. *@
    <section class="card" aria-label="Answer trace">
        <div class="card-h">
            <h2>Answer trace</h2>
            <div class="btns">
                <a href="how-it-works" class="muted">Full walkthrough</a>
                <button type="button" class="sec small" disabled="@(selected < 0 || turns[selected].Pending)" @onclick="() => ShowTraceAsync(selected)">Replay</button>
            </div>
        </div>
        <div class="trace">
            @if (selected < 0)
            {
                <p class="muted">Ask a question to see the request move through guardrails, memory, the intent model, Azure AI Search and Azure OpenAI. Switch to Agent mode to watch Semantic Kernel call the MCP tools.</p>
            }
            else
            {
                var t = turns[selected];
                <div class="q-banner">Question: <b>@t.Question</b></div>
                @* PathMap draws the request path (UI -> API -> Guardrails -> ... -> Response) and lights the current step. *@
                <PathMap Nodes="@(t.Agent ? AgentNodes : RagNodes)" Lit="@LitNode(t)" Stopped="@(t.Blocked && shown >= t.Steps.Count)"
                         Route="@(t.Agent ? "POST /agent/chat" : "POST /chat")" />
                @* One list item per step; the state class (active, done, stop, skip) drives the colours. *@
                <ol class="steps">
                    @for (var i = 0; i < t.Steps.Count; i++)
                    {
                        var s = t.Steps[i];
                        var state = t.Pending ? "" : i < shown ? s.Final : i == shown ? "active" : "";
                        <li class="step @state">
                            <div class="node">@(state == "done" ? "✓" : state == "stop" ? "!" : (i + 1).ToString())</div>
                            <div class="body">
                                <div class="row1"><h3>@s.Title @if (s.Tag is not null) { <span class="src">@s.Tag</span> }</h3></div>
                                <div class="what">@s.What</div>
                                @if (state != "" && s.Detail is not null)
                                {
                                    <div class="detail">@s.Detail</div>
                                }
                            </div>
                        </li>
                    }
                </ol>
                <div class="legend">
                    <span>Built from the live API response.</span>
                    <span><span class="cite scan">SCAN-…</span> clause read by OCR from a scanned endorsement</span>
                </div>
            }
        </div>
    </section>
</div>

@* Lower row: renewal draft workflow and audit chain check. *@
<div class="lower">
    <section class="card" aria-label="Renewal draft">
        <div class="card-h">
            <h2>Renewal draft</h2>
            @if (draft is not null) { <span class="badge @StatusBadge(draft.Status)">@draft.Status</span> }
        </div>
        <div class="pad">
            @* The draft status flow: Draft -> Pending approval -> Approved -> Sent (simulated). *@
            <div class="flow">
                <span class="st @(draft is null ? "on" : "")">Draft</span><span class="ar">→</span>
                <span class="st @(draft?.Status == "PENDING_APPROVAL" ? "on" : "")">Pending approval</span><span class="ar">→</span>
                <span class="st @(draft?.Status == "APPROVED" ? "on" : "")">Approved</span><span class="ar">→</span>
                <span class="st @(draft?.Status == "SIMULATED_SENT" ? "on" : "")">Sent (simulated)</span>
            </div>
            @if (draft is not null)
            {
                <div class="draft">
                    @draft.Message
                    <div class="meta">
                        @foreach (var c in draft.Citations) { <span class="cite">@($"{c.SourceId}#{c.ClauseId}")</span> }
                    </div>
                </div>
                <div class="btns">
                    <button type="button" class="ok" @onclick="ApproveAsync" disabled="@busy">Approve</button>
                    <button type="button" class="sec" @onclick="SendAsync" disabled="@busy">Send</button>
                </div>
                @* Send is never disabled in the UI on purpose: the SERVER enforces approval and consent. *@
                <p class="muted">The Send button stays clickable on purpose. The server decides whether sending is allowed.</p>
            }
            else
            {
                <div class="btns"><button type="button" @onclick="CreateDraftAsync" disabled="@(busy || customer is null)">Create renewal draft</button></div>
            }
        </div>
    </section>

    @* Audit trail card: calls GET /audit/verify and shows whether the hash chain is intact. *@
    <section class="card" aria-label="Audit trail">
        <div class="card-h">
            <h2>Audit trail</h2>
            @if (audit is not null) { <span class="badge @(audit.Valid ? "g" : "r")">@(audit.Valid ? "Chain valid" : "Chain broken")</span> }
        </div>
        <div class="pad">
            @if (audit is not null)
            {
                @if (audit.Valid)
                {
                    <p class="muted">@audit.TotalEvents hash-chained events, none changed.</p>
                }
                else
                {
                    <p class="muted" style="color:var(--red)">Chain is BROKEN at event #@audit.BrokenAtSeq of @audit.TotalEvents.</p>
                }
            }
            else
            {
                <p class="muted">Every chat, tool call, draft and send is written to a hash-chained log.</p>
            }
            <div class="btns"><button type="button" class="sec" @onclick="VerifyAuditAsync" disabled="@busy">Verify audit chain</button></div>
        </div>
    </section>
</div>

@* Everything below is the page's C# code. *@
@code {
    // One step in the answer trace. Final is the state it ends in: done, stop or skip.
    private record Step(string Title, string What, RenderFragment? Detail, string Final = "done", string? Tag = null, int Node = 0);

    // One chat turn as shown on the page (question, answer, citations and the trace steps).
    private class Turn
    {
        public required string Question { get; init; }
        public bool Agent { get; init; }
        public bool Pending { get; set; } = true;
        public bool Blocked { get; set; }
        public string Answer { get; set; } = "";
        public List<Citation> Citations { get; set; } = new();
        public Comparison? Comparison { get; set; }
        public List<Step> Steps { get; set; } = new();
    }

    // The boxes drawn by PathMap for each mode. The index of a box is the Step.Node value.
    private static readonly List<PathMap.Node> RagNodes = new()
    {
        new("UI", "Blazor"), new("API", "FastAPI"), new("SAFE", "Guardrails"), new("MEM", "Rewrite"),
        new("ML", "Intent"), new("AIS", "AI Search"), new("AOAI", "OpenAI"), new("RES", "Response"),
    };

    private static readonly List<PathMap.Node> AgentNodes = new()
    {
        new("UI", "Blazor"), new("API", "FastAPI"), new("SAFE", "Guardrails"), new("SK", "Kernel"),
        new("MCP", "MCP tools"), new("AIS", "AI Search"), new("AOAI", "OpenAI"), new("RES", "Response"),
    };

    // The quick-question chips. "and what about Gold?" shows follow-up memory working.
    private static readonly string[] Suggestions =
    {
        "What is the waiting period for pre-existing diseases?",
        "and what about Gold?",
        "Compare Silver and Gold",
        "Is air ambulance covered for Health Gold?",
    };

    // Page state. Blazor re-renders the page when these change.
    private string customerId = "C-204";
    private string question = "";
    private Customer? customer;
    private readonly List<Turn> turns = new();
    private int selected = -1;
    private int shown;
    private int playId;
    private bool agentMode;
    private Draft? draft;
    private AuditStatus? audit;
    private string? error;
    private string? info;
    private bool busy;
    private bool? apiOk;
    private SentimentReport? sentimentReport;

    // /?customer=C-450 (the Radar's "Open" link) loads that customer straight away.
    [SupplyParameterFromQuery(Name = "customer")] public string? CustomerFromUrl { get; set; }

    // After the first render, check the API's /health once.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            apiOk = await Client.HealthAsync();
            if (!string.IsNullOrWhiteSpace(CustomerFromUrl))
            {
                customerId = CustomerFromUrl.Trim();
                await LoadCustomerAsync();
            }
            StateHasChanged();
        }
    }

    // Wraps every button action: disables buttons while busy and clears old messages.
    private async Task Run(Func<Task> work)
    {
        busy = true;
        error = null;
        info = null;
        try { await work(); }
        finally { busy = false; }
    }

    // GET /customers/{id}. A new customer clears the chat and any old draft.
    private async Task LoadCustomerAsync() => await Run(async () =>
    {
        var r = await Client.GetCustomerAsync(customerId.Trim());
        sentimentReport = null;
        if (r.Success)
        {
            customer = r.Data;
            // Sentiment is extra context: if it fails, the workspace still works.
            var s = await Client.GetSentimentAsync(customer!.CustomerId);
            sentimentReport = s.Success ? s.Data : null;
            draft = null;
            turns.Clear();
            selected = -1;
        }
        else
        {
            customer = null;
            error = r.Error;
        }
    });

    private async Task OnKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !busy)
            await AskAsync(question);
    }

    // Sends one question to /chat or /agent/chat, then builds and plays the trace.
    private async Task AskAsync(string text)
    {
        if (customer is null || string.IsNullOrWhiteSpace(text))
            return;

        var q = text.Trim();
        question = "";
        var turn = new Turn { Question = q, Agent = agentMode };
        turns.Add(turn);
        selected = turns.Count - 1;
        shown = 0;

        // Same session id every time, so the API's memory can resolve follow-ups.
        await Run(async () =>
        {
            if (turn.Agent)
            {
                var r = await Client.AgentChatAsync(new ChatRequest(customer.CustomerId, q, Session.SessionId));
                if (r.Success)
                {
                    turn.Answer = r.Data!.Answer;
                    turn.Citations = r.Data.Citations;
                    turn.Steps = AgentSteps(q, customer.CustomerId, r.Data);
                }
                // The agent endpoint answers a prompt injection with a 400 "BLOCKED" error.
                else if (r.Error?.Contains("BLOCKED") == true)
                {
                    turn.Blocked = true;
                    turn.Answer = r.Error;
                    turn.Steps = AgentSteps(q, customer.CustomerId, null);
                }
                else error = r.Error;
            }
            else
            {
                var r = await Client.ChatAsync(new ChatRequest(customer.CustomerId, q, Session.SessionId));
                if (r.Success)
                {
                    var d = r.Data!;
                    turn.Answer = d.Answer;
                    turn.Citations = d.Citations;
                    turn.Comparison = d.Comparison;
                    // /chat answers a prompt injection with intent "prompt_injection".
                    turn.Blocked = d.Intent == "prompt_injection";
                    turn.Steps = RagSteps(q, d);
                }
                else error = r.Error;
            }
        });

        turn.Pending = false;
        // Nothing came back (an error was shown), so drop the empty turn.
        if (turn.Steps.Count == 0)
        {
            turns.Remove(turn);
            selected = turns.Count - 1;
            return;
        }
        await ShowTraceAsync(selected);
    }

    // Reveal the trace one step at a time, so the demo shows the order things happen in.
    private async Task ShowTraceAsync(int index)
    {
        if (index < 0 || index >= turns.Count) return;
        // playId cancels an older replay if the user starts a new one.
        var id = ++playId;
        selected = index;
        var steps = turns[index].Steps;
        for (shown = 0; shown <= steps.Count; shown++)
        {
            StateHasChanged();
            if (shown == steps.Count) break;
            await Task.Delay(steps[shown].Final == "skip" ? 120 : 550);
            if (id != playId) return;
        }
    }

    // Which PathMap box should be lit right now.
    private int LitNode(Turn t)
    {
        if (t.Pending || t.Steps.Count == 0) return 1;
        if (shown >= t.Steps.Count) return t.Blocked ? 2 : (t.Agent ? AgentNodes : RagNodes).Count - 1;
        return t.Steps[shown].Node;
    }

    private static string CiteTitle(Citation c) =>
        $"Version {c.Version}" + (IsScan(c) ? " · read by OCR from a scanned endorsement" : "");

    private static bool IsScan(Citation c) => c.SourceId.StartsWith("SCAN-", StringComparison.OrdinalIgnoreCase);

    // A row of citation chips, used inside the trace steps.
    private RenderFragment CiteChips(List<Citation> cites) => @<div class="meta">
        @foreach (var c in cites)
        {
            <span class="cite @(IsScan(c) ? "scan" : "")">@($"{c.SourceId}#{c.ClauseId} · {c.Version}")</span>
            @if (IsScan(c)) { <span class="badge a">from OCR scan</span> }
        }
    </div>;

    // Formats a number the same way on every server locale.
    private static string Num(double v, string fmt) => v.ToString(fmt, System.Globalization.CultureInfo.InvariantCulture);

    private static string ScoreNote(string? retriever) => retriever == "azure"
        ? "Score is the Azure AI Search semantic reranker score, from 0 (unrelated) to 4 (very relevant)."
        : "Score is the fused rank score from keyword (BM25) and vector search. Higher means a better match.";

    private static RenderFragment IntentBars(Dictionary<string, double> scores) => @<div class="bars">
        @{ var first = true; }
        @foreach (var (label, p) in scores.OrderByDescending(x => x.Value))
        {
            var pct = Math.Round(p * 100, 1);
            <div class="bar @(first ? "top" : "")"><span class="lbl">@label</span><span class="track"><span class="fillbar" style="width:@Num(pct, "0.#")%"></span></span><span class="v">@Num(pct, "0.#")%</span></div>
            first = false;
        }
    </div>;

    // Clause retrieval step: one summary line, with the query, filter and ranked hits behind "Show details".
    private static RenderFragment SearchDetail(ChatResponse d, List<RetrievedClause> hits, string summary) => @<div>
        <span>@summary <span class="muted">Top score @Num(hits[0].Score, hits[0].Score < 0.1 ? "0.0000" : "0.00")</span></span>
        <details class="more">
            <summary>Show details</summary>
            <div class="dkv">
                @if (d.SearchQuery is { } sq) { <span class="k">Query sent</span><span class="m">@sq</span> }
                @if (d.SearchFilter is { Count: > 0 } sf)
                {
                    <span class="k">Filter</span><span class="m">@string.Join(" and ", sf.Select(kv => $"({kv.Key} = '{kv.Value}' or 'All')"))</span>
                }
                <span class="k">Mode</span><span>@(d.Retriever == "azure" ? "Hybrid: keyword + vector (text-embedding-3-small), then the semantic reranker" : "Hybrid: BM25 keyword + MiniLM vector, merged with reciprocal rank fusion")</span>
            </div>
            @HitRows(hits)
            <div class="muted scorenote">@ScoreNote(d.Retriever) Highlighted rows were cited in the answer. Only these clauses are given to the LLM. Code: api/app/services/retriever.py.</div>
        </details>
    </div>;

    private static RenderFragment HitRows(List<RetrievedClause> hits) => @<div class="hits">
        @foreach (var h in hits)
        {
            var scan = h.SourceId.StartsWith("SCAN-", StringComparison.OrdinalIgnoreCase);
            <div class="hit @(h.Used ? "used" : "")">
                <div class="score">@Num(h.Score, h.Score < 0.1 ? "0.0000" : "0.00")</div>
                <div>
                    <div class="id">@h.SourceId#@h.ClauseId · @h.Version @if (scan) { <span class="badge a">OCR scan</span> } @if (h.Used) { <span class="badge b">cited</span> }</div>
                    <div class="txt">@(h.Text.Length > 160 ? h.Text[..157].TrimEnd() + "…" : h.Text)</div>
                </div>
            </div>
        }
    </div>;

    // Builds the trace for a /chat answer from the API response.
    private List<Step> RagSteps(string q, ChatResponse d)
    {
        var steps = new List<Step>();
        // Blocked: one red step, the rest marked as skipped.
        if (d.Intent == "prompt_injection")
        {
            steps.Add(new("Guardrails", "Prompt-injection check before retrieval or the LLM",
                @<span><span class="verdict fail">Blocked</span>This looks like a prompt-injection attempt. Nothing after this step ran.</span>, "stop", Node: 2));
            foreach (var (title, node) in new[] { ("Follow-up rewrite", 3), ("Intent classification", 4), ("Clause retrieval", 5), ("Grounded answer", 6) })
                steps.Add(new(title, "", @<span>Skipped. The guardrail stopped this question.</span>, "skip", Node: node));
            return steps;
        }
        // Off-topic: polite redirect, retrieval skipped.
        if (d.Intent == "out_of_scope" && d.Citations.Count == 0)
        {
            steps.Add(new("Guardrails", "Off-topic check", @<span><span class="verdict warn">Redirected</span>Not an insurance question, so Saathi replied with a polite redirect and did not search.</span>, Node: 2));
            steps.Add(new("Clause retrieval", "", @<span>Skipped. Off-topic questions are not searched.</span>, "skip", Node: 5));
            return steps;
        }

        steps.Add(new("Guardrails", "Prompt-injection and off-topic checks",
            @<span><span class="verdict pass">Passed</span>Policy question for @customer?.CustomerId.</span>, Node: 2));

        // Show the follow-up rewrite if memory changed the question.
        var resolved = d.ResolvedQuestion;
        steps.Add(new("Follow-up rewrite", "Chat memory completes short follow-ups",
            resolved is not null && !string.Equals(resolved, q, StringComparison.OrdinalIgnoreCase)
                ? @<div class="rewrite"><div class="from">@q</div><div>→ @resolved</div></div>
                : @<span class="muted">Already a complete question. No rewrite needed.</span>, Tag: "memory", Node: 3));

        var model = d.IntentModel ?? "tfidf_lr";
        steps.Add(new("Intent classification",
            d.IntentScores is { Count: > 0 } s ? $"{model} model, {s.Count} intent classes" : $"{model} model",
            @<div>
                <span>Predicted intent <span class="badge b">@d.Intent</span>
                    @if (d.IntentConfidence is { } conf) { <span class="muted">with @Num(conf * 100, "0.#")% confidence</span> }</span>
                @if (d.IntentScores is { Count: > 0 })
                {
                    <details class="more">
                        <summary>Show details</summary>
                        <div class="sub">Probability for each class</div>
                        @IntentBars(d.IntentScores)
                        @if (d.IntentFeatures is { Count: > 0 } feats)
                        {
                            <div class="sub">Words that drove the prediction</div>
                            <div class="terms">
                                @foreach (var f in feats)
                                {
                                    <span class="term @(f.Weight < 0 ? "neg" : "")" title="TF-IDF value x model weight">@f.Term <b>@(f.Weight >= 0 ? "+" : "")@Num(f.Weight, "0.00")</b></span>
                                }
                            </div>
                        }
                        <div class="muted scorenote">
                            @if (model == "tfidf_lr")
                            {
                                <span>How it works: TF-IDF turns the question into word and word-pair weights, then logistic regression gives each class a probability. A plus number pushed towards <b>@d.Intent</b>, a minus number pushed away. </span>
                            }
                            The probabilities are uncalibrated. They label the request for the trace and the audit log, and never decide access. Code: api/app/services/ml_service.py · classify_intent().
                        </div>
                    </details>
                }
            </div>, Tag: "ML", Node: 4));

        var hits = d.Retrieved ?? new();
        var where = d.Retriever == "azure" ? "Azure AI Search" : "Local hybrid search";
        if (d.Comparison is { } cmp)
        {
            steps.Add(new("Clause retrieval", "Azure AI Search, one search per tier",
                @<span>Built a @string.Join(" vs ", cmp.Tiers) table with @cmp.Rows.Count rows, every cell cited.</span>, Tag: "Azure AI Search", Node: 5));
        }
        else if (d.Citations.Count > 0)
        {
            steps.Add(new("Clause retrieval", $"{where}, top {Math.Max(hits.Count, 1)}, filtered to {customer?.Product}",
                hits.Count > 0
                    ? SearchDetail(d, hits, $"{d.Citations.Count} of {hits.Count} clauses cited in the answer.")
                    : @<span>@d.Citations.Count clause@(d.Citations.Count == 1 ? "" : "s") used for the answer.</span>, Tag: where, Node: 5));
            steps.Add(new("Grounded answer", "Azure OpenAI writes only from the retrieved clauses",
                @<div class="stream">@d.Answer</div>, Tag: "Azure OpenAI", Node: 6));
        }
        else if (hits.Count > 0)
        {
            steps.Add(new("Clause retrieval", $"{where}, top {hits.Count}, filtered to {customer?.Product}",
                SearchDetail(d, hits, $"{hits.Count} clauses found, none cited."), Tag: where, Node: 5));
            steps.Add(new("Grounded answer", "Grounding shield",
                @<span><span class="verdict warn">Not found</span>None of these clauses supported an answer, so Saathi said it could not find it instead of guessing.</span>, Tag: "Azure OpenAI", Node: 6));
        }
        else
        {
            steps.Add(new("Answer source", "Customer record or not found",
                @<span>No clauses were cited. The answer came from the customer's record, or the policy documents did not cover it.</span>, Node: 6));
        }

        if (d.Citations.Count > 0 || d.Comparison is not null)
        {
            var cites = d.Comparison is { } c2
                ? c2.Rows.SelectMany(r => r.Cells.Values).Where(v => v is not null).Select(v => new Citation(v!.SourceId, v.ClauseId, v.Version)).Distinct().ToList()
                : d.Citations;
            steps.Add(new("Citations", "Versioned clause references", CiteChips(cites), Node: 7));
        }
        return steps;
    }

    // Builds the trace for an /agent/chat answer: kernel, each MCP tool call, then the grounded answer.
    // What each MCP tool does, shown under "Show details" on an agent tool call.
    private static readonly Dictionary<string, (string What, string Rule)> ToolInfo = new()
    {
        ["lookup_customer"] = ("Reads the customer's CRM record: product, tier, consent, renewal date and policy status.", "customer_id is replaced with the selected customer, whatever the model asked for."),
        ["worklist"] = ("Lists the agent's customers whose policy can still be renewed (ACTIVE or IN_GRACE).", "agent_id is replaced with the signed-in agent."),
        ["search_knowledge_base"] = ("Searches the policy clauses in Azure AI Search, filtered by product and tier, and returns cited clauses.", "Only clauses returned here can be cited in the answer."),
        ["save_draft"] = ("Creates a renewal message draft for the customer.", "Saved as PENDING_APPROVAL. A human must approve it."),
        ["simulate_send"] = ("Pretends to send an approved draft. Nothing real is sent.", "Refused unless a human approved the draft and the customer gave consent."),
    };

    private List<Step> AgentSteps(string q, string customerIdForRun, AgentChatResponse? d)
    {
        var steps = new List<Step>();
        if (d is null)
        {
            steps.Add(new("Guardrails", "Prompt-injection check", @<span><span class="verdict fail">Blocked</span>The API refused the request before the kernel was built.</span>, "stop", Node: 2));
            steps.Add(new("Semantic Kernel", "", @<span>Skipped.</span>, "skip", Node: 3));
            return steps;
        }

        steps.Add(new("Guardrails", "Prompt-injection check", @<span><span class="verdict pass">Passed</span></span>, Node: 2));
        steps.Add(new("Semantic Kernel", "Kernel with the saathi plugin and a tool-limit filter",
            @<span>Orchestrator <span class="badge v">@d.Orchestrator</span>. The five MCP tools are registered as one plugin. The model may call at most 3.</span>, Tag: "SK", Node: 3));

        for (var i = 0; i < d.Trace.Count; i++)
        {
            var call = d.Trace[i];
            var n = i + 1;
            // Show the tool arguments, hiding empty ones.
            var args = string.Join(", ", call.Args
                .Where(a => !(a.Value.ValueKind == JsonValueKind.String && a.Value.GetString() == ""))
                .Select(a => $"{a.Key}: {a.Value.GetRawText()}"));
            var scoped = call.Args.ContainsKey("customer_id");
            steps.Add(new($"Tool call {n} of 3: {call.Tool}", "MCP tool invoked through the SK plugin",
                @<div>
                    <pre class="code">@($"{call.Tool}({args})")</pre>
                    <span>
                        @if (call.Ok) { <span class="verdict pass">ok</span> } else { <span class="verdict fail">refused</span> }
                        @if (scoped) { <span class="muted">customer_id is forced to @customerIdForRun in code</span> }
                        <span class="budget">@for (var b = 0; b < 3; b++) { <i class="@(b < n ? "used" : "")"></i> }</span>
                    </span>
                    @if (ToolInfo.TryGetValue(call.Tool, out var info))
                    {
                        <details class="more">
                            <summary>Show details</summary>
                            <div class="dkv">
                                <span class="k">What it does</span><span>@info.What</span>
                                <span class="k">Rule in code</span><span>@info.Rule</span>
                                <span class="k">Code</span><span class="m">api/app/agent/tools.py · @(call.Tool)()</span>
                            </div>
                        </details>
                    }
                </div>, call.Ok ? "done" : "stop", "MCP", call.Tool == "search_knowledge_base" ? 5 : 4));
        }
        if (d.Trace.Count == 0)
            steps.Add(new("Tool calls", "", @<span class="muted">The planner did not call any tool.</span>, Node: 4));

        steps.Add(new("Grounded answer", "generate_answer applies the grounding shield",
            @<div class="stream">@d.Answer</div>, Tag: "Azure OpenAI", Node: 6));
        if (d.Citations.Count > 0)
            steps.Add(new("Citations", "Only clauses the search tool returned", CiteChips(d.Citations), Node: 7));
        return steps;
    }

    // Draft buttons: each one calls the API and shows the server's answer (or its BLOCKED error).
    private async Task CreateDraftAsync() => await Run(async () =>
    {
        var r = await Client.CreateDraftAsync(customer!.CustomerId);
        if (r.Success) draft = r.Data; else error = r.Error;
    });

    private async Task ApproveAsync() => await Run(async () =>
    {
        var r = await Client.ApproveDraftAsync(draft!.DraftId);
        if (r.Success) { draft = r.Data; info = "Draft approved by the agent."; } else error = r.Error;
    });

    private async Task SendAsync() => await Run(async () =>
    {
        var r = await Client.SendDraftAsync(draft!.DraftId);
        if (r.Success) { draft = r.Data; info = "Message sent (simulated). Nothing real is ever sent."; } else error = r.Error;
    });

    private async Task VerifyAuditAsync() => await Run(async () =>
    {
        var r = await Client.VerifyAuditAsync();
        if (r.Success) audit = r.Data; else error = r.Error;
    });

    // Badge colour for each draft status.
    private static string StatusBadge(string status) => status switch
    {
        "PENDING_APPROVAL" => "a",
        "APPROVED" => "b",
        "SIMULATED_SENT" => "g",
        _ => "r"
    };
}
