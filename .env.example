# Set environment variables in your terminal; .env is not loaded automatically.
# Never commit actual credentials.
ML_PROVIDER=local
INTENT_PROVIDER=distilbert
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=
AZURE_ML_COMPUTE=
AZURE_ML_ENDPOINT_NAME=
AZURE_ML_INSTANCE_TYPE=Standard_DS3_v2
AZURE_ML_ENDPOINT=
AZURE_ML_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# Worklist credentials: server-owned file with SHA-256 token digests and scoped agents.
# No default credentials; /worklist requires Bearer authentication.
SAATHI_AGENT_CREDENTIALS_FILE=
# Optional CRM-linked input paths; never defaults to training data.
RADAR_INPUT_FILE=
RADAR_CUSTOMERS_FILE=
# Explicit capstone snapshot; unset for current UTC date in central customer policy logic.
SAATHI_AS_OF_DATE=2026-10-28
# Explicit live checks only: existing approved agent token, never a default identity.
SAATHI_LIVE_AGENT_TOKEN=
